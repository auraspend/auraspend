*.log

# Per-variant output directories. These are NOT named "build", so the build/
# rule above does not cover them. /app/release/ was listed but /app/free/ and
# /app/play/ were not, which left a 79MB app-play-release.apk and its baseline
# profiles one `git add -A` away from being committed. *.apk and *.aab below
# cover the artifact itself but not output-metadata.json or the .dm profiles.
# These are output dirs, not source sets — the flavor sources live in
# app/src/free/ and app/src/play/, which these patterns do not touch.
/app/free/
/app/play/
/app/release/

# Host venvs, downloaded models and scratch build dirs.
# NOTE: the comment must be on its own line. A trailing "# ..." after a pattern
# is part of the pattern, not a comment -- which silently made the rule below
# inert and left ~40MB of venv plus ONNX weights stageable.
.zcode/
.zcodeignore

# Local AI tooling state (agent settings, sessions).
.claude/

# Kotlin incremental-compilation state (holds absolute paths).
/.kotlin/

# Python bytecode from tools/ scripts
tools/__pycache__/

# OpenChamber tool state (local screenshots / session data).
/.openchamber/

# A screenshot-editor scaffold dropped at the repo root. The maintained editor
# lives in docs/store/ and is tracked; a root copy brings ~370 MB of node_modules
# and its own stale deck, which is a trap one `git add -A` away from the history.
app-store-screenshots/

# Kilo tool state (local session data).
/.kilo/

# WorkBuddy tool state (local agent memory).
/.workbuddy-ai/

# Parked screenshot deck variations (docs/store/variant.sh). Kept on disk
# deliberately — they are alternatives, not the shipping deck — so they stay out
# of released history. The live deck's own frame source is tracked.
docs/store/variants/

# Session captures of the implemented UI. The concept itself — index.html and
# board.png — is tracked; these are working shots and go stale the moment the
# screens change.
docs/design/interface-concept/implemented/
