            android:action="android.intent.action.VIEW"
            android:targetPackage="com.awbuilds.auraspend"
            android:targetClass="com.awbuilds.auraspend.MainActivity">
            <extra android:name="shortcut_action" android:value="activity" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_review_sms"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_sms"
        android:shortcutShortLabel="@string/shortcut_review_sms_short"
        android:shortcutLongLabel="@string/shortcut_review_sms_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.awbuilds.auraspend"
            android:targetClass="com.awbuilds.auraspend.MainActivity">
